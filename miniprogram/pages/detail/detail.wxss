/* pages/detail/detail.wxss —— 商品详情页的样式 */

.page {
  padding: 48rpx 32rpx;
}

.detail-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  background: linear-gradient(135deg, #ffe3c2 0%, #fff1e3 100%);
  border-radius: 32rpx;
  overflow: hidden;
}

.detail-emoji {
  font-size: 160rpx;
  line-height: 1;
}

/* 售罄时盖在商品图上的遮罩 */
.detail-hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  letter-spacing: 8rpx;
  color: #ffffff;
  background: rgba(58, 36, 23, 0.55);
}

.detail-card {
  margin-top: 32rpx;
  padding: 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 36, 23, 0.06);
}

.detail-name-row {
  display: flex;
  align-items: center;
}

.detail-name {
  font-size: 44rpx;
  font-weight: 700;
}

.detail-tag {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  color: #e8590c;
  background: #fff0e0;
  border: 1rpx solid #ffd8b0;
  border-radius: 8rpx;
}

/* 售罄标签：用灰色，和普通标签区分开 */
.detail-tag-soldout {
  color: #8c7b6b;
  background: #f0e6dc;
  border-color: #e3d5c8;
}

.detail-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #a08b78;
}

.detail-price {
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #e8590c;
}

/* 价格后面的单位：/串、/3串 */
.detail-unit {
  margin-left: 6rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #a08b78;
}

.detail-count {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #e8590c;
  background: #fff7ee;
  border-radius: 16rpx;
}

.detail-add {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #ff7a00;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 0, 0.28);
}

.detail-add-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 售罄状态：按钮置灰，没有阴影，看起来就“点不动” */
.detail-add-disabled {
  color: #ffffff;
  background: #d9cec3;
  box-shadow: none;
}

.detail-back {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a08b78;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #a08b78;
}
