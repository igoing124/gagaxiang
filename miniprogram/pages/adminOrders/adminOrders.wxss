/* pages/adminOrders/adminOrders.wxss —— 商家订单管理 */
.page {
  padding: 32rpx;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 0 8rpx 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a08b78;
}

.head-actions {
  display: flex;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.head-btn {
  margin-left: 12rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #e8590c;
  background: #fff7ee;
  border: 1rpx solid #ffd8b0;
  border-radius: 999rpx;
}

.head-btn-primary {
  color: #ffffff;
  background: #ff7a00;
  border-color: #ff7a00;
}

/* 自动刷新提示 */
.auto-refresh {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 8rpx 18rpx;
  font-size: 22rpx;
  color: #a08b78;
}

.alert-test {
  color: #e8590c;
  text-decoration: underline;
}

/* 新订单提示条 */
.new-order-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 22rpx 26rpx;
  background: #fff2e5;
  border: 1rpx solid #ffd8b0;
  border-radius: 20rpx;
  animation: order-tip-pulse 1.2s ease-in-out infinite;
}

.new-order-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #e8590c;
}

.new-order-tip-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #e8590c;
}

@keyframes order-tip-pulse {
  0%,
  100% {
    background: #fff2e5;
  }
  50% {
    background: #ffe3c8;
  }
}

/* 状态提示 */
.state-card {
  margin-top: 24rpx;
  padding: 40rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 36, 23, 0.06);
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
}

.state-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #a08b78;
}

.openid {
  display: block;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  font-family: Consolas, "SF Mono", Menlo, monospace;
  font-size: 22rpx;
  word-break: break-all;
  color: #e8590c;
  background: #fff7ee;
  border-radius: 12rpx;
}

.copy-btn {
  margin-top: 20rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #ffffff;
  background: #ff7a00;
  border-radius: 999rpx;
}

/* 筛选 tab */
.tabs {
  display: flex;
  padding: 8rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 36, 23, 0.06);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #8c7b6b;
  border-radius: 14rpx;
}

.tab-active {
  font-weight: 600;
  color: #ffffff;
  background: #ff7a00;
}

.tab-badge {
  min-width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  color: #e8590c;
  background: #fff0e0;
  border-radius: 999rpx;
}

.tab-active .tab-badge {
  color: #ff7a00;
  background: #ffffff;
}

/* 订单卡片 */
.order-card {
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 36, 23, 0.06);
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-id {
  font-size: 24rpx;
  color: #8c7b6b;
}

.status-tag {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.status-pending {
  color: #e8590c;
  background: #fff2e5;
}

.status-making {
  color: #b7791f;
  background: #fff8e1;
}

.status-delivering {
  color: #1c7ed6;
  background: #eaf4ff;
}

.status-completed,
.status-done {
  color: #2b8a3e;
  background: #eafaf1;
}

.status-cancelled,
.status-canceled {
  color: #868e96;
  background: #f1f3f5;
}

.order-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a08b78;
}

.customer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 28rpx;
}

.customer-name {
  font-weight: 600;
}

.customer-phone {
  color: #e8590c;
}

.order-address {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b5848;
}

.order-items {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #3a2417;
  background: #fff8f0;
  border-radius: 14rpx;
}

.order-remark {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #c0392b;
}

.order-money {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f7efe7;
}

.money-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #e8590c;
}

.money-sub {
  font-size: 22rpx;
  color: #a08b78;
}

.pay-mode {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a08b78;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.action {
  margin-left: 12rpx;
  padding: 14rpx 26rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.action-ghost {
  color: #6b5848;
  background: #f8f5f1;
}

.action-warn {
  color: #c0392b;
  background: #fff5f2;
  border: 1rpx solid #ffd0c0;
}

.action-primary {
  color: #ffffff;
  background: #ff7a00;
}

.action-disabled {
  opacity: 0.5;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-emoji {
  font-size: 60rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #a08b78;
}
