/* pages/notes/notes.wxss —— 学习笔记页的样式 */

.page {
  padding: 40rpx 32rpx 64rpx;
}

.notes-hero {
  padding: 40rpx 36rpx;
  background: linear-gradient(135deg, #3a2417 0%, #5c3a24 100%);
  border-radius: 32rpx;
  color: #ffffff;
}

.notes-title {
  font-size: 40rpx;
  font-weight: 700;
}

.notes-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #f3d9c4;
}

.section-list {
  margin-top: 28rpx;
}

.section-card {
  display: flex;
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 36, 23, 0.06);
}

.section-index {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  background: #ff7a00;
  border-radius: 50%;
}

.section-body {
  flex: 1;
  min-width: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b5848;
}

.section-code {
  display: block;
  margin-top: 16rpx;
  padding: 24rpx;
  font-family: Consolas, "SF Mono", Menlo, monospace;
  font-size: 23rpx;
  line-height: 1.7;
  color: #ffd9b3;
  background: #2b1b12;
  border-radius: 16rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.exercise-card {
  margin-top: 8rpx;
  padding: 32rpx;
  background: #fff3e4;
  border: 1rpx solid #ffd8b0;
  border-radius: 28rpx;
}

.exercise-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #c2410c;
}

.exercise-item {
  display: flex;
  margin-top: 18rpx;
}

.exercise-dot {
  margin-right: 12rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: #ff7a00;
}

.exercise-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b5848;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a08b78;
}
